{
  "$schemaVersion": 1,
  "status": "provisional",
  "description": "Declarative UI dependency proposals. Confirm each rule against actual engine behavior before using it to mutate settings. Hide/show and enable/disable should not silently overwrite persisted values unless a rule explicitly says so.",
  "rules": [
    {
      "id": "upscaler-details",
      "controller": "graphics.upscaling.mode",
      "cases": [
        {
          "equals": "Upscaling_Off",
          "hide": ["graphics.upscaling.fsr_preset", "graphics.upscaling.fsr_custom_val", "graphics.upscaling.dlss_preset", "graphics.upscaling.dlss_custom_val"]
        },
        {
          "equals": "Upscaling_FSR",
          "show": ["graphics.upscaling.fsr_preset"],
          "hide": ["graphics.upscaling.dlss_preset", "graphics.upscaling.dlss_custom_val"],
          "showWhen": [{"controller": "graphics.upscaling.fsr_preset", "equals": "FSR_Custom", "target": "graphics.upscaling.fsr_custom_val"}],
          "capability": {"setting": "Upscaling_FSR", "requires": "graphics.is_fsr_available"}
        },
        {
          "equals": "Upscaling_DLSS",
          "show": ["graphics.upscaling.dlss_preset"],
          "hide": ["graphics.upscaling.fsr_preset", "graphics.upscaling.fsr_custom_val"],
          "showWhen": [{"controller": "graphics.upscaling.dlss_preset", "equals": "DLSS_Custom", "target": "graphics.upscaling.dlss_custom_val"}],
          "capability": {"setting": "Upscaling_DLSS", "requires": "graphics.is_dlss_available"}
        }
      ],
      "fallback": "Keep inactive backend values stored but hide them; do not clear them merely because another backend is selected."
    },
    {
      "id": "frame-generation-backend-availability",
      "controller": "graphics.frame_generation.mode",
      "cases": [
        {"equals": "FrameGeneration_Off", "hide": ["graphics.frame_generation.multiplier"]},
        {"equals": "FrameGeneration_FSR", "show": ["graphics.frame_generation.multiplier"], "requires": "graphics.is_fsr_frame_generation_available"},
        {"equals": "FrameGeneration_DLSS", "show": ["graphics.frame_generation.multiplier"], "requires": "graphics.is_dlss_frame_generation_available"}
      ],
      "note": "The payload lists FSR and DLSS frame-generation capability flags. Exact compatible upscaler/frame-generation combinations and supported multipliers must be confirmed with the engine/Streamline integration."
    },
    {
      "id": "frame-generation-multiplier-options",
      "controller": "graphics.frame_generation.mode",
      "optionCapabilities": {
        "FrameGeneration_FSR": {
          "FrameGeneration_2x": "graphics.can_use_fsr_frame_generation_2x",
          "FrameGeneration_3x": "graphics.can_use_fsr_frame_generation_3x",
          "FrameGeneration_4x": "graphics.can_use_fsr_frame_generation_4x"
        },
        "FrameGeneration_DLSS": {
          "FrameGeneration_2x": "graphics.can_use_dlss_frame_generation_2x",
          "FrameGeneration_3x": "graphics.can_use_dlss_frame_generation_3x",
          "FrameGeneration_4x": "graphics.can_use_dlss_frame_generation_4x"
        }
      },
      "behavior": "Only offer multiplier values whose corresponding capability flag is true."
    },
    {
      "id": "triple-screen-panel",
      "controller": "display.is_triple",
      "whenTrueShow": ["display.triple_screen", "display.panini"],
      "whenFalseHide": ["display.triple_screen", "display.panini"]
    },
    {
      "id": "hmd-panel",
      "controller": "display.is_stereo",
      "whenTrueShow": ["vr", "graphics.mirror.multi_mode_vr"],
      "whenFalseHide": ["vr", "graphics.mirror.multi_mode_vr"]
    },
    {
      "id": "custom-view-distance",
      "controller": "graphics.viewDistance.quality",
      "whenEquals": "ViewDistanceQuality_Custom",
      "enable": ["graphics.viewDistance.overallDistance", "graphics.viewDistance.objectDistance", "graphics.viewDistance.treeDistance", "graphics.viewDistance.vegetationDistance", "graphics.viewDistance.crowdDistance", "graphics.viewDistance.shadowDistance"],
      "otherwise": "Show as read-only or collapsed preset results; whether preset changes overwrite custom values is an engine/product decision."
    },
    {
      "id": "custom-anisotropic-filtering",
      "controller": "graphics.anisotropicFiltering.anisotropicFilteringQuality",
      "whenEquals": "AnisotropicFilteringQuality_Custom",
      "show": ["graphics.anisotropicFiltering.customSettings"],
      "otherwiseHide": ["graphics.anisotropicFiltering.customSettings"]
    },
    {
      "id": "custom-cloud-settings",
      "controller": "graphics.clouds.cloudsQuality",
      "whenEquals": "CloudsQuality_Custom",
      "show": ["graphics.clouds.cloudsCustomSettings"],
      "otherwiseHide": ["graphics.clouds.cloudsCustomSettings"]
    },
    {
      "id": "eye-tracking-foveation-capability",
      "controller": "vr.can_use_eye_tracking",
      "whenTrueShow": ["vr.eye_tracked_foveated_rendering"],
      "whenFalseHide": ["vr.eye_tracked_foveated_rendering"]
    }
  ],
  "implementationNotes": [
    "Capability flags are read-only inputs, not user-editable settings.",
    "Use disabled controls with an explanation when an option is relevant but temporarily unavailable; hide mutually exclusive backend details when they do not apply.",
    "Do not infer renderer-reset requirements from visibility dependencies."
  ]
}
