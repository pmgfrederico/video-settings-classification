  "frameGeneration": [
    { "id": "off", "label": "Off", "vendor": "native", "engineSupport": "shipping", "family": "none" },
    {
      "id": "dlss_fg",
      "label": "DLSS Frame Generation",
      "short": "DLSS FG",
      "vendor": "nvidia",
      "family": "dlss",
      "engineSupport": "shipping",
      "requires": { "ref": "facts:sdk.dlss_g.supported", "eq": true },
      "blockedBy": [
        {
          "when": { "ref": "facts:os.hags", "eq": false },
          "reason": "Needs Hardware-accelerated GPU scheduling (HAGS), which is off in Windows.",
          "fix": { "label": "Open Windows graphics settings", "url": "ms-settings:display-advancedgraphics", "note": "Turn on HAGS, then restart the PC." }
        }
      ],
      "maxMultiplierRef": "facts:sdk.dlss_g.maxMultiplier",
      "couplesTo": { "field": "graphics.latency.mode", "allowed": ["reflex", "reflex_boost"], "force": "reflex", "kind": "force" },
      "summary": "RTX 40 series: 2x. RTX 50 series: multi-frame generation up to the engine-reported maximum.",
      "v2": { "mode": "FrameGeneration_DLSS" }
    },
    {
      "id": "fsr_fg",
      "label": "AMD FSR Frame Generation",
      "short": "FSR FG",
      "vendor": "amd",
      "family": "fsr",
      "engineSupport": "shipping",
      "requires": { "ref": "facts:sdk.fsr_fg.supported", "eq": true },
      "maxMultiplierRef": "facts:sdk.fsr_fg.maxMultiplier",
      "couplesTo": { "field": "graphics.latency.mode", "allowed": ["antilag2"], "kind": "suggest" },
      "summary": "Works on most modern GPUs. Pairs with Anti-Lag 2 where available.",
      "v2": { "mode": "FrameGeneration_FSR" }
    },
    {
      "id": "xess_fg",
      "label": "Intel XeSS Frame Generation",
      "short": "XeSS FG",
      "vendor": "intel",
      "family": "xess",
      "engineSupport": "proposed",
      "requires": { "ref": "facts:sdk.xess_fg.supported", "eq": true },
      "maxMultiplierRef": "facts:sdk.xess_fg.maxMultiplier",
      "couplesTo": { "field": "graphics.latency.mode", "allowed": ["xell"], "force": "xell", "kind": "force" },
      "summary": "XeSS 2 frame generation. Always runs with XeLL.",
      "v2": null
    }
  ],
  "latency": [
    { "id": "off", "label": "Off", "vendor": "native", "engineSupport": "shipping", "queueFactor": 2.5 },
    { "id": "reflex", "label": "NVIDIA Reflex", "short": "Reflex", "vendor": "nvidia", "engineSupport": "shipping", "requires": { "ref": "facts:sdk.reflex.supported", "eq": true }, "queueFactor": 1.4, "v2": "Reflex_On" },
    { "id": "reflex_boost", "label": "Reflex + Boost", "short": "Reflex+Boost", "vendor": "nvidia", "engineSupport": "shipping", "requires": { "ref": "facts:sdk.reflex.supported", "eq": true }, "queueFactor": 1.3, "v2": "Reflex_OnPlusBoost", "note": "Keeps GPU clocks high when CPU-bound. Uses more power." },
    { "id": "antilag2", "label": "AMD Anti-Lag 2", "short": "Anti-Lag 2", "vendor": "amd", "engineSupport": "proposed", "requires": { "ref": "facts:sdk.antilag2.supported", "eq": true }, "queueFactor": 1.45 },
    { "id": "xell", "label": "Intel XeLL", "short": "XeLL", "vendor": "intel", "engineSupport": "proposed", "requires": { "ref": "facts:sdk.xell.supported", "eq": true }, "queueFactor": 1.45 }
