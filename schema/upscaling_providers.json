{
  "$comment": "Concept -> provider -> mode matrix (taxonomy facet F12, rule R14). Scales are per-axis render scales relative to output resolution. 'requires' / 'blockedBy' use the condition language described in docs/01-taxonomy-and-rules.md §5. Engine-reported SDK support (facts.sdk.*) is the source of truth; vendor/arch notes are informative. engineSupport: 'shipping' = present in today's config (schema v2), 'proposed' = added by the v4 provider abstraction.",
  "version": 1,
  "concepts": {
    "upscaling": {
      "label": "Upscaling",
      "question": "Render at a lower resolution and reconstruct to your output resolution?",
      "field": "graphics.upscaling.provider"
    },
    "frameGeneration": {
      "label": "Frame Generation",
      "question": "Insert generated frames between rendered ones for higher presented FPS?",
      "field": "graphics.frame_generation.provider"
    },
    "latency": {
      "label": "Latency Reduction",
      "question": "Shorten the CPU→GPU render queue to reduce input-to-photon latency?",
      "field": "graphics.latency.mode"
    }
  },
  "upscaling": [
    {
      "id": "off",
      "label": "Off",
      "vendor": "native",
      "engineSupport": "shipping",
      "family": "none",
      "summary": "Native rendering, no reconstruction.",
      "modes": []
    },
    {
      "id": "dlss",
      "label": "NVIDIA DLSS",
      "short": "DLSS",
      "vendor": "nvidia",
      "family": "dlss",
      "engineSupport": "shipping",
