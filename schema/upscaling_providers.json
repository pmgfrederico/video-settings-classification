        { "id": "quality", "label": "Quality", "scale": 0.5882 },
        { "id": "balanced", "label": "Balanced", "scale": 0.5 },
        { "id": "performance", "label": "Performance", "scale": 0.4348 },
        { "id": "ultra_performance", "label": "Ultra Performance", "scale": 0.3333 },
        { "id": "custom", "label": "Custom", "scale": null, "disclosure": "advanced" }
