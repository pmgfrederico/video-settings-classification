        { "id": "native_aa", "label": "Native AA", "scale": 1.0, "engineSupport": "proposed" },
        { "id": "ultra_quality", "label": "Ultra Quality", "scale": 0.77, "v2": "FSR_UltraQuality", "note": "Engine-specific ratio carried over from the v2 config; not an AMD-named FSR 4 preset" },
        { "id": "quality", "label": "Quality", "scale": 0.6667, "v2": "FSR_Quality" },
        { "id": "balanced", "label": "Balanced", "scale": 0.5882, "v2": "FSR_Balanced" },
        { "id": "performance", "label": "Performance", "scale": 0.5, "v2": "FSR_Performance" },
        { "id": "ultra_performance", "label": "Ultra Performance", "scale": 0.3333, "engineSupport": "proposed" },
        { "id": "custom", "label": "Custom", "scale": null, "v2": "FSR_Custom", "disclosure": "advanced" }
