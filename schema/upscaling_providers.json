        { "id": "dlaa", "label": "DLAA", "scale": 1.0, "engineSupport": "proposed", "note": "Native-resolution anti-aliasing" },
        { "id": "quality", "label": "Quality", "scale": 0.6667, "v2": "DLSS_Quality" },
        { "id": "balanced", "label": "Balanced", "scale": 0.58, "v2": "DLSS_Balanced" },
        { "id": "performance", "label": "Performance", "scale": 0.5, "v2": "DLSS_Performance" },
        { "id": "ultra_performance", "label": "Ultra Performance", "scale": 0.3333, "v2": "DLSS_UltraPerformance" },
        { "id": "custom", "label": "Custom", "scale": null, "v2": "DLSS_Custom", "disclosure": "advanced" }
