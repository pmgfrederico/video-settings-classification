          "graphics.shadow.shadowQuality": "ShadowQuality_Ultra", "graphics.ambientOcclusion": "AmbientOcclusionQuality_High",
          "graphics.enviromentReflection": "EnvironmentReflectionQuality_High", "graphics.clouds.cloudsQuality": "CloudsQuality_High",
          "graphics.volumetricsQuality": "VolumetricsQuality_High", "graphics.grass": "GrassDensity_High",
          "graphics.particles.quality": "ParticlesQuality_High", "graphics.terrain.groundQuality": "GroundQuality_High",
          "graphics.carReflection.carReflectionQuality": "CarReflectionQuality_High"
        }
      }
    },
    {
      "parent": "graphics.viewDistance.quality",
      "customValue": "ViewDistanceQuality_Custom",
      "note": "Values taken from graphics.viewDistance.presets in input/raw_settings_config.json",
      "presets": {
        "ViewDistanceQuality_Low": { "graphics.viewDistance.overallDistance": 2000, "graphics.viewDistance.objectDistance": 800, "graphics.viewDistance.treeDistance": 1000, "graphics.viewDistance.vegetationDistance": 150, "graphics.viewDistance.crowdDistance": 300, "graphics.viewDistance.shadowDistance": 650 },
        "ViewDistanceQuality_Medium": { "graphics.viewDistance.overallDistance": 4000, "graphics.viewDistance.objectDistance": 1500, "graphics.viewDistance.treeDistance": 2000, "graphics.viewDistance.vegetationDistance": 300, "graphics.viewDistance.crowdDistance": 600, "graphics.viewDistance.shadowDistance": 500 },
        "ViewDistanceQuality_High": { "graphics.viewDistance.overallDistance": 8000, "graphics.viewDistance.objectDistance": 2500, "graphics.viewDistance.treeDistance": 3500, "graphics.viewDistance.vegetationDistance": 500, "graphics.viewDistance.crowdDistance": 1000, "graphics.viewDistance.shadowDistance": 700 },
        "ViewDistanceQuality_Ultra": { "graphics.viewDistance.overallDistance": 16000, "graphics.viewDistance.objectDistance": 5000, "graphics.viewDistance.treeDistance": 6000, "graphics.viewDistance.vegetationDistance": 1000, "graphics.viewDistance.crowdDistance": 2000, "graphics.viewDistance.shadowDistance": 1000 }
      }
    },
    {
      "parent": "graphics.anisotropicFiltering.anisotropicFilteringQuality",
      "customValue": "AnisotropicFilteringQuality_Custom",
      "note": "The High row matches the saved config. Low and Medium are illustrative.",
      "presets": {
        "AnisotropicFilteringQuality_Low": { "graphics.anisotropicFiltering.customSettings.mainAnisotropicFiltering": 2, "graphics.anisotropicFiltering.customSettings.mainLowAnisotropicFiltering": 1, "graphics.anisotropicFiltering.customSettings.cubemapMirrorAnisotropicFiltering": 1 },
        "AnisotropicFilteringQuality_Medium": { "graphics.anisotropicFiltering.customSettings.mainAnisotropicFiltering": 4, "graphics.anisotropicFiltering.customSettings.mainLowAnisotropicFiltering": 2, "graphics.anisotropicFiltering.customSettings.cubemapMirrorAnisotropicFiltering": 1 },
        "AnisotropicFilteringQuality_High": { "graphics.anisotropicFiltering.customSettings.mainAnisotropicFiltering": 8, "graphics.anisotropicFiltering.customSettings.mainLowAnisotropicFiltering": 4, "graphics.anisotropicFiltering.customSettings.cubemapMirrorAnisotropicFiltering": 1 }
      }
    },
    {
      "parent": "graphics.clouds.cloudsQuality",
      "customValue": "CloudsQuality_Custom",
      "note": "The High row matches the saved config. Low and Medium are illustrative.",
      "presets": {
        "CloudsQuality_Low": { "graphics.clouds.cloudsCustomSettings.resolution": 256, "graphics.clouds.cloudsCustomSettings.renderingTimeslicedOverFramesNumber": 32 },
        "CloudsQuality_Medium": { "graphics.clouds.cloudsCustomSettings.resolution": 512, "graphics.clouds.cloudsCustomSettings.renderingTimeslicedOverFramesNumber": 16 },
        "CloudsQuality_High": { "graphics.clouds.cloudsCustomSettings.resolution": 1024, "graphics.clouds.cloudsCustomSettings.renderingTimeslicedOverFramesNumber": 16 }
      }
    },
    {
      "parent": "graphics.carReflection.carReflectionQuality",
      "customValue": "CarReflectionQuality_Custom",
      "note": "No preset tables are known (the saved custom values are 0). Children only switch the parent to Custom.",
      "presets": {}
    }
  ]
}
