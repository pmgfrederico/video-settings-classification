          "graphics.viewDistance.quality": "ViewDistanceQuality_Medium", "graphics.levelOfDetail.levelOfDetail": "LevelOfDetailQuality_Medium",
          "graphics.shadow.shadowQuality": "ShadowQuality_Medium", "graphics.ambientOcclusion": "AmbientOcclusionQuality_Medium",
          "graphics.enviromentReflection": "EnvironmentReflectionQuality_Medium", "graphics.clouds.cloudsQuality": "CloudsQuality_Medium",
          "graphics.volumetricsQuality": "VolumetricsQuality_Low", "graphics.grass": "GrassDensity_Medium",
          "graphics.particles.quality": "ParticlesQuality_Medium", "graphics.terrain.groundQuality": "GroundQuality_Medium",
          "graphics.carReflection.carReflectionQuality": "CarReflectionQuality_Medium"
        },
        "videoOptionHigh": {
          "graphics.textureQuality": "TextureQuality_High", "graphics.materialQuality": "MaterialQuality_High",
          "graphics.viewDistance.quality": "ViewDistanceQuality_High", "graphics.levelOfDetail.levelOfDetail": "LevelOfDetailQuality_High",
          "graphics.shadow.shadowQuality": "ShadowQuality_High", "graphics.ambientOcclusion": "AmbientOcclusionQuality_High",
          "graphics.enviromentReflection": "EnvironmentReflectionQuality_High", "graphics.clouds.cloudsQuality": "CloudsQuality_High",
          "graphics.volumetricsQuality": "VolumetricsQuality_Medium", "graphics.grass": "GrassDensity_High",
          "graphics.particles.quality": "ParticlesQuality_High", "graphics.terrain.groundQuality": "GroundQuality_High",
          "graphics.carReflection.carReflectionQuality": "CarReflectionQuality_High"
