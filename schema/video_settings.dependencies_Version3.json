          "graphics.viewDistance.quality": "ViewDistanceQuality_Low", "graphics.levelOfDetail.levelOfDetail": "LevelOfDetailQuality_Low",
          "graphics.shadow.shadowQuality": "ShadowQuality_Low", "graphics.ambientOcclusion": "AmbientOcclusionQuality_Low",
          "graphics.enviromentReflection": "EnvironmentReflectionQuality_Low", "graphics.clouds.cloudsQuality": "CloudsQuality_Low",
          "graphics.volumetricsQuality": "VolumetricsQuality_Off", "graphics.grass": "GrassDensity_Low",
          "graphics.particles.quality": "ParticlesQuality_Low", "graphics.terrain.groundQuality": "GroundQuality_Low",
          "graphics.carReflection.carReflectionQuality": "CarReflectionQuality_Low"
        },
        "videoOptionMedium": {
